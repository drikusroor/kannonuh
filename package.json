{
  "name": "kannonuh",
  "version": "0.1.0",
  "private": true,
  "description": "Kannonuh — a turn-based artillery siege game for the web, Discord Activities ready.",
  "module": "src/server/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run build:client && bun --watch src/server/index.ts",
    "start": "bun run build:client && bun src/server/index.ts",
    "serve": "bun src/server/index.ts",
    "build:client": "bun run scripts/build-client.ts",
    "watch:client": "bun run scripts/build-client.ts --watch",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2"
  }
}
